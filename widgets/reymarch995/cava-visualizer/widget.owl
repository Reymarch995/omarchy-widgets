widget "android-cava-visualizer" {
  meta { owl: 6; description: "Visualize Android internal audio with CAVA via the WiFi Audio Streaming app's HTTP stream"; version: "1.0"; license: "MIT"; category: "fun" }
  page: 1
  order: 3
  size: 6x2
  minSize: 3x1

  requires { pacman: ["python", "cava", "ffmpeg"] }

  state paused = false persist
  state showGuide = false
  source settings = file("~/.config/omalauncher/cava-visualizer/settings.json") json
  let endpoint = settings.endpoint ?? ""
  let barCount = int(num(settings.bars, 12))
  let sensitivity = int(num(settings.sensitivity, 60))
  let jitteriness = int(num(settings.jitteriness, 23))
  let saveSettings = """
import json, sys
from pathlib import Path

path = Path.home() / ".config/omalauncher/cava-visualizer/settings.json"
path.parent.mkdir(parents=True, exist_ok=True)
try:
    data = json.loads(path.read_text())
except (OSError, ValueError):
    data = {}

args = sys.argv[1:]
for index in range(0, len(args), 4):
    key, low, high, raw = args[index:index + 4]
    if raw.lstrip("-").isdigit():
        data[key] = max(int(low), min(int(high), int(raw)))

temp = path.with_name(path.name + ".tmp")
temp.write_text(json.dumps(data) + chr(10))
temp.replace(path)
"""

  component NumberSetting(key, labelText, current, low, high, step = 1) {
    Column {
      Text { text: labelText; style: label }
      Row {
        gap: 6
        Button {
          text: "←"
          onTap: run("python3 -c ${sh(saveSettings)} ${sh(key)} ${int(low)} ${int(high)} ${int(current - step)}")
        }
        Slider {
          value: current
          min: low
          max: high
          step: step
          weight: 1
          onChange: run("python3 -c ${sh(saveSettings)} ${sh(key)} ${int(low)} ${int(high)} ${int(value)}")
        }
        Button {
          text: "→"
          onTap: run("python3 -c ${sh(saveSettings)} ${sh(key)} ${int(low)} ${int(high)} ${int(current + step)}")
        }
        Input {
          text: str(current)
          placeholder: "number"
          width: 74
          onSubmit: run("python3 -c ${sh(saveSettings)} ${sh(key)} ${int(low)} ${int(high)} ${sh(trim(value))}")
        }
      }
    }
  }

  // Keep the bridge in this file so a store install needs no helper scripts.
  source frame = stream("""python3 -c '
import json, os, select, signal, subprocess, tempfile, time
from pathlib import Path
from urllib.parse import urlsplit

stopping = False
def stop(_sig, _frame):
    global stopping
    stopping = True
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)

def emit(ok, values):
    print(json.dumps({"ok": ok, "bars": values, "scale": 3.0}, separators=(",", ":")), flush=True)

def stop_process(proc):
    if proc is None or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=1)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()

root = Path.home() / ".config/omalauncher/cava-visualizer"
settings_file = root / "settings.json"
print(json.dumps({"ok": False, "bars": [], "scale": 3.0,
                  "message": "connecting to app"}, separators=(",", ":")), flush=True)

while not stopping:
    try:
        cfg = json.loads(settings_file.read_text())
    except (OSError, ValueError):
        cfg = {}
    if not isinstance(cfg, dict):
        cfg = {}
    endpoint = str(cfg.get("endpoint") or "").strip()
    if not endpoint:
        print(json.dumps({"ok": False, "bars": [], "scale": 3.0,
                          "message": "set app IP:port"}, separators=(",", ":")), flush=True)
        time.sleep(1)
        continue
    try:
        raw_url = endpoint if "://" in endpoint else "http://" + endpoint
        parsed = urlsplit(raw_url)
        if parsed.scheme != "http":
            raise ValueError
        host = parsed.hostname or ""
        if not host or any(ch.isspace() for ch in host):
            raise ValueError
        port = parsed.port
        if not port or parsed.query or parsed.fragment or parsed.username or parsed.password:
            raise ValueError
        authority = f"[{host}]" if ":" in host else host
        path = parsed.path.rstrip("/") or "/stream"
        url = f"http://{authority}:{port}{path}"
        count = max(4, min(64, int(cfg.get("bars", 12))))
        sensitivity = max(1, min(200, int(cfg.get("sensitivity", 60))))
        jitteriness = max(0, min(100, int(cfg.get("jitteriness", 23))))
    except (ValueError, TypeError):
        print(json.dumps({"ok": False, "bars": [], "scale": 3.0,
                          "message": "check app IP:port"}, separators=(",", ":")), flush=True)
        time.sleep(1)
        continue
    zero = [0] * count
    try:
        stat = settings_file.stat()
        version = stat.st_mtime_ns, stat.st_size
    except OSError:
        version = None
    changed = False
    with tempfile.TemporaryDirectory(prefix="oma-cava-") as temp:
        fifo = Path(temp) / "audio.fifo"
        config = Path(temp) / "cava.conf"
        os.mkfifo(fifo, 0o600)
        config.write_text(chr(10).join([
            "[general]", f"bars = {count}", "bar_width = 1", "bar_spacing = 0",
            "framerate = 30", "autosens = 0", f"sensitivity = {sensitivity}",
            "[input]", "method = fifo", f"source = {fifo}", "sample_rate = 44100",
            "sample_bits = 16", "[smoothing]", f"noise_reduction = {100 - jitteriness}", "[output]",
            "method = raw", "channels = mono", "raw_target = /dev/stdout",
            "data_format = ascii", "ascii_max_range = 1000", "bar_delimiter = 59",
            "frame_delimiter = 10"
        ]) + chr(10))
        cava = ffmpeg = None
        fifo_out = None
        try:
            cava = subprocess.Popen(["cava", "-p", str(config)], stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, bufsize=0)
            os.set_blocking(cava.stdout.fileno(), False)
            ffmpeg = subprocess.Popen([
                "ffmpeg", "-nostdin", "-hide_banner", "-loglevel", "error",
                "-rw_timeout", "3000000", "-reconnect", "1", "-reconnect_streamed", "1",
                "-reconnect_delay_max", "3", "-probesize", "32768", "-analyzeduration", "0",
                "-f", "aac", "-i", url, "-vn", "-f", "s16le", "-acodec", "pcm_s16le",
                "-ar", "44100", "-ac", "2", "pipe:1"], stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
            os.set_blocking(ffmpeg.stdout.fileno(), False)
            fifo_out = os.open(fifo, os.O_WRONLY)
            buffer = b""
            last_frame = last_emit = time.monotonic()
            while not stopping and ffmpeg.poll() is None and cava.poll() is None:
                try:
                    stat = settings_file.stat()
                    current_version = stat.st_mtime_ns, stat.st_size
                except OSError:
                    current_version = None
                if current_version != version:
                    changed = True
                    break
                ready, _, _ = select.select([cava.stdout, ffmpeg.stdout], [], [], 0.1)
                if ffmpeg.stdout in ready:
                    try:
                        pcm = os.read(ffmpeg.stdout.fileno(), 8192)
                        if pcm:
                            view = memoryview(pcm)
                            while view:
                                written = os.write(fifo_out, view)
                                view = view[written:]
                    except BlockingIOError:
                        pass
                if cava.stdout in ready:
                    latest = None
                    while True:
                        try:
                            chunk = os.read(cava.stdout.fileno(), 8192)
                        except BlockingIOError:
                            break
                        if not chunk:
                            break
                        buffer += chunk
                        while True:
                            cut = buffer.find(bytes([10]))
                            if cut < 0:
                                break
                            line, buffer = buffer[:cut], buffer[cut + 1:]
                            try:
                                values = [max(0, min(1, int(v) / 1000))
                                          for v in line.decode("ascii").split(";") if v]
                                if len(values) >= count:
                                    latest = values[:count]
                            except ValueError:
                                pass
                        if len(buffer) > 16384:
                            buffer = b""
                    if latest is not None:
                        emit(True, latest)
                        last_frame = last_emit = time.monotonic()
                now = time.monotonic()
                if now - last_frame > 2.5:
                    break
                if now - last_emit > 1:
                    emit(False, zero)
                    last_emit = now
        except (OSError, subprocess.SubprocessError):
            pass
        finally:
            stop_process(ffmpeg)
            stop_process(cava)
            if fifo_out is not None:
                os.close(fifo_out)
            if ffmpeg is not None and ffmpeg.stdout is not None:
                ffmpeg.stdout.close()
            if cava is not None and cava.stdout is not None:
                cava.stdout.close()
    if not stopping:
        print(json.dumps({"ok": False, "bars": zero, "scale": 3.0,
                          "message": "start app or check URL"}, separators=(",", ":")), flush=True)
        if not changed:
            time.sleep(2)
'""") json

  let bars = frame != null && frame.ok == true ? frame.bars : []
  let active = frame != null && frame.ok == true
  let scale = frame != null ? num(frame.scale, 3.0) : 3.0
  let audible = !paused && active && any(bars, v => num(v, 0) > 0.015)

  Box {
    fill: true
    Canvas {
      fill: true
      // Each CAVA sample maps directly to one visible bar.
      let n = min(len(bars), 64)
      if !paused && n > 0 {
        let gap = max(2, width * 0.012)
        let bw = max(2, (width - gap * (n - 1)) / n)
        for i in range(n) {
          let level = clamp(num(bars[i], 0) * scale, 0, 1)
          let bh = height * level
          let x = i * (bw + gap)
          let y = height - bh
          rect(x, y, bw, bh, radius: min(bw / 2, 6), fill: active ? mix(accent, cyan, i / max(n - 1, 1) * 0.45) : alpha(muted, 0.28))
        }
      }
      if !paused && !audible {
        text(frame != null && frame.message != null ? frame.message : "waiting for audio",
             width / 2, height / 2, size: 13, align: center, color: foreground)
      }
    }

    Row {
      fill: true
      gap: 4
      justify: spaceBetween
      align: top
      Button { text: "⚙︎"; background: surface; onTap: screen() }
      Button { text: paused ? "▶" : "Ⅱ"; background: surface; onTap: paused = !paused }
    }

    Box {
      fill: true
      align: center
      if paused { Text { text: "[paused]"; style: title; color: muted; align: center } }
    }
  }

  screen {
    title: "visualizer settings"
    Column {
      fill: true
      scroll: true
      gap: 10

      Button { text: showGuide ? "hide guide ?" : "guide ?"; onTap: showGuide = !showGuide }
      if showGuide {
        Text {
          text: "Install WiFi Audio Streaming. In the app, choose Send (Server), select HTTP/Web, then start streaming. Play audio on the phone and enter the server IP:port below. If there is no audio, open the app settings and make sure Internal Audio is toggled on; grant capture permission if prompted. If latency is too high, decrease it in the app."
          style: body
          color: foreground
        }
      }

      Text { text: "audio server address"; style: label }
      Input {
        text: endpoint
        placeholder: "192.168.1.20:8080 or http://…"
        onSubmit: {
          run("python3 -c 'import json,sys; from pathlib import Path; p=Path.home()/\".config/omalauncher/cava-visualizer/settings.json\"; p.parent.mkdir(parents=True,exist_ok=True); d=json.loads(p.read_text()) if p.exists() else {}; d[sys.argv[1]]=sys.argv[2]; t=p.with_name(p.name+\".tmp\"); t.write_text(json.dumps(d)+chr(10)); t.replace(p)' endpoint ${sh(trim(value))}")
        }
      }

      NumberSetting { key: "bars"; labelText: "bar count"; current: barCount; low: 4; high: 64 }
      NumberSetting { key: "sensitivity"; labelText: "sensitivity"; current: sensitivity; low: 1; high: 200 }
      NumberSetting { key: "jitteriness"; labelText: "jitteriness (higher = more)"; current: jitteriness; low: 0; high: 100 }
      Button {
        text: "reset CAVA defaults"
        onTap: run("python3 -c ${sh(saveSettings)} bars 4 64 12 sensitivity 1 200 60 jitteriness 0 100 23")
      }

      Button { text: "close"; onTap: close() }
    }
  }
}
